# Скопируйте этот файл в .env для локальной разработки и заполните значения.
# В Replit используйте Replit Secrets, а не .env — .env туда не коммитится (см. .gitignore).
# Никогда не записывайте реальные ключи в этот файл или в git.

# --- Приложение ---
ENV=development
APP_NAME="Ozon AI Аналитик"
DEMO_MODE=false

# --- База данных (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ozon_analytics

# Используются только docker-compose (см. README, "Развёртывание на своём
# сервере") — из них собирается DATABASE_URL контейнера app автоматически,
# значение выше в DATABASE_URL при этом игнорируется. Для локального запуска
# без Docker эти три переменные не нужны.
POSTGRES_USER=ozon_app
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_DB=ozon_analytics

# --- Сессии и шифрование ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-random-secret

# Флаг Secure у сессионной cookie. По умолчанию (не задано / пусто) берётся
# из ENV: true при ENV=production, иначе false. Браузеры НИКОГДА не отправляют
# Secure-cookie обратно по обычному HTTP — если сервер работает без TLS
# (доступ по IP/http://, без домена и nginx-оверлея), при ENV=production вход
# будет молча ломаться после первого запроса (login вернёт 200, но все
# последующие запросы — 401). Раскомментируйте и поставьте false, если у вас
# именно такой временный HTTP-only запуск; уберите/оставьте пустым, как
# только появится TLS.
# SESSION_COOKIE_SECURE=false

# Ключ шифрования Ozon-ключей в БД (Fernet, 32 байта в urlsafe-base64).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# --- ИИ-провайдер (Yandex AI Studio) ---
AI_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest

# --- CORS (для локальной разработки frontend на отдельном порту) ---
CORS_ORIGINS=http://localhost:5173
