# Скопируйте этот файл в .env для локальной разработки и заполните значения.
# В Replit используйте Replit Secrets, а не .env — .env туда не коммитится (см. .gitignore).
# Никогда не записывайте реальные ключи в этот файл или в git.

# --- Приложение ---
ENV=development
APP_NAME="Ozon AI Аналитик"
DEMO_MODE=false

# --- База данных (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ozon_analytics

# Используются только docker-compose (см. README, "Развёртывание на своём
# сервере") — из них собирается DATABASE_URL контейнера app автоматически,
# значение выше в DATABASE_URL при этом игнорируется. Для локального запуска
# без Docker эти три переменные не нужны.
POSTGRES_USER=ozon_app
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_DB=ozon_analytics

# --- Сессии и шифрование ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-random-secret

# Флаг Secure у сессионной cookie. По умолчанию (не задано / пусто) берётся
# из ENV: true при ENV=production, иначе false. Браузеры НИКОГДА не отправляют
# Secure-cookie обратно по обычному HTTP — если сервер работает без TLS
# (доступ по IP/http://, без домена и nginx-оверлея), при ENV=production вход
# будет молча ломаться после первого запроса (login вернёт 200, но все
# последующие запросы — 401). Раскомментируйте и поставьте false, если у вас
# именно такой временный HTTP-only запуск; уберите/оставьте пустым, как
# только появится TLS.
# SESSION_COOKIE_SECURE=false

# Ключ шифрования Ozon-ключей в БД (Fernet, 32 байта в urlsafe-base64).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# --- ИИ-провайдер (Yandex AI Studio) ---
AI_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest

# --- CORS (для локальной разработки frontend на отдельном порту) ---
CORS_ORIGINS=http://localhost:5173

# --- Автосбор статистики рекламы (Ozon Performance API) ---
# Необязательно — значения по умолчанию подходят большинству. См. README,
# "Автоматический сбор статистики рекламы (Performance API, без CSV)".
# ADVERTISING_STATS_BATCH_SIZE=10
# ADVERTISING_STATS_POLL_INTERVAL_SECONDS=15
# ADVERTISING_STATS_POLL_TIMEOUT_SECONDS=600
# ADVERTISING_STATS_DEFAULT_LOOKBACK_DAYS=7
# ADVERTISING_STATS_SCHEDULER_ENABLED=true
# ADVERTISING_STATS_SCHEDULER_HOUR_UTC=3

# --- Автосбор заказов/выкупов (страница «РНП», Ozon Seller API) ---
# Необязательно. Каждый прогон заново забирает ВЕСЬ период целиком (не только
# новые дни), поэтому увеличение глубины истории подтягивает всю новую
# глубину уже на следующий прогон, а не постепенно. См. README, раздел
# «Интеграция с Ozon Seller API».
# ORDER_STATS_DEFAULT_LOOKBACK_DAYS=30
# ORDER_STATS_SCHEDULER_ENABLED=true
# ORDER_STATS_SCHEDULER_HOUR_UTC=3
# ORDER_STATS_SCHEDULER_MINUTE_UTC=30

# --- Автосбор воронки карточки товара (Ozon Analytics API, требуется Premium
# Plus/Premium Pro) ---
# Необязательно. Как и с заказами выше, каждый прогон забирает весь период
# заново. Ozon разрешает не более 1 запроса в минуту к этому методу — если
# за период набирается больше 1000 строк (SKU×день), синхронизация делает
# несколько запросов подряд с паузой в 60 секунд между ними, вплоть до
# MAX_PAGES. См. README, раздел «Воронка карточки товара (POST
# /v1/analytics/data)».
# PRODUCT_ANALYTICS_STATS_DEFAULT_LOOKBACK_DAYS=30
# PRODUCT_ANALYTICS_STATS_MAX_PAGES=10
# PRODUCT_ANALYTICS_STATS_RATE_LIMIT_SLEEP_SECONDS=60
# PRODUCT_ANALYTICS_STATS_SCHEDULER_ENABLED=true
# PRODUCT_ANALYTICS_STATS_SCHEDULER_HOUR_UTC=3
# PRODUCT_ANALYTICS_STATS_SCHEDULER_MINUTE_UTC=45
